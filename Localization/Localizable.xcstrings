    },
    "SM Launcher Plus will install SuperMetroidRecomp from your own ROM, keep it up to date, and let you tune its settings and mods. Your ROM stays where it is.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SM Launcher Plus installera SuperMetroidRecomp à partir de votre propre ROM, le tiendra à jour et vous permettra de régler ses paramètres et ses mods. Votre ROM reste où elle est."
          }
        }
      }
    },
