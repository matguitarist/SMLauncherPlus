    "“%@” is made for another game (%@), not Super Metroid.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » est fait pour un autre jeu (%2$@), pas pour Super Metroid."
