        }
      }
    },
    "What's New": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouveautés"
          }
        }
      }
    },
    "What's New in SuperMetroidRecomp %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
