      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement ne contient pas SuperMetroidSNESRecomp."
          }
        }
      }
    },
    "The download holds a file that would land outside the game folder (%@).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement contient un fichier qui sortirait du dossier du jeu (%@)."
          }
        }
      }
    },
    "The download is damaged. Try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement est endommagé. Réessayez."
          }
        }
      }
    },
    "The downloaded zip can't be opened.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le zip téléchargé ne peut pas être ouvert."
          }
        }
      }
    },
    "The files couldn't be put in place. There may not be enough space on the disk.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers n’ont pas pu être mis en place. Le disque manque peut-être d’espace."
          }
        }
      }
    },
    "The game files of this profile are missing. Install the game again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers du jeu de ce profil sont introuvables. Installez le jeu de nouveau."
          }
        }
      }
    },
    "The game is running. Changes apply the next time you play.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu est en cours. Les changements s’appliqueront la prochaine fois que vous jouerez."
          }
        }
      }
    },
    "The game left no log.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu n’a laissé aucun journal."
          }
        }
      }
    },
    "The game left nothing to report.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu n’a rien laissé à signaler."
          }
        }
      }
    },
    "The game stopped unexpectedly": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu s’est arrêté de façon inattendue"
          }
        }
      }
    },
    "The latest release can't be checked: it has no checksum for the Mac build. Try again later.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière version ne peut pas être vérifiée : elle n’a pas de somme de contrôle pour la version Mac. Réessayez plus tard."
          }
        }
      }
    },
    "The latest release has no build for this Mac yet. Try again later.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière version n’a pas encore de version pour ce Mac. Réessayez plus tard."
          }
        }
      }
    },
    "The new language applies after a restart.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nouvelle langue s’applique après un redémarrage."
          }
        }
      }
    },
    "This ROM has been patched. Use an unmodified copy; mods are added in SM Launcher Plus.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette ROM a été modifiée. Utilisez une copie intacte ; les mods s’ajoutent dans SM Launcher Plus."
          }
        }
      }
    },
    "This ROM isn't the supported version. SM Launcher Plus needs Super Metroid (Japan, USA).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette ROM n’est pas la version prise en charge. SM Launcher Plus a besoin de Super Metroid (Japan, USA)."
          }
        }
      }
    },
    "This file is the wrong size for a SNES ROM.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier n’a pas la bonne taille pour une ROM SNES."
          }
        }
      }
    },
    "This is the ROM of “%@”, not Super Metroid.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est la ROM de « %@ », pas de Super Metroid."
          }
        }
      }
    },
    "This isn't a SNES ROM. Choose a .sfc, .smc or .zip file.": {
      "localizations": {
