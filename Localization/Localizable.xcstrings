            "value": "Composite chaud"
          }
        }
      }
    },
    "What SM Launcher Plus does is written here: downloads, installs, and each time the game starts or stops.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que fait SM Launcher Plus est noté ici : téléchargements, installations, et chaque démarrage ou arrêt du jeu."
