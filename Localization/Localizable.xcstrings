          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas une ROM SNES. Choisissez un fichier .sfc, .smc ou .zip."
          }
        }
      }
    },
    "This version of the game has no mods.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version du jeu n’a aucun mod."
          }
        }
      }
