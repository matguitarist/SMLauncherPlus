    "That folder already has an item named “%@”. Choose another folder.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier contient déjà un élément nommé « %@ ». Choisissez un autre dossier."
          }
        }
      }
    },
    "The copy doesn't match the original (%@). The old folder is unchanged.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie ne correspond pas à l’original (%@). L’ancien dossier n’a pas changé."
          }
        }
      }
    },
    "The disk with the data folder isn't connected. Connect it, then reopen SM Launcher Plus.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque qui contient le dossier de données n’est pas branché. Branchez-le, puis rouvrez SM Launcher Plus."
          }
        }
      }
    },
    "The download has no SuperMetroidSNESRecomp in it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement ne contient pas SuperMetroidSNESRecomp."
          }
        }
      }
    },
    "The download holds a file that would land outside the game folder (%@).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement contient un fichier qui sortirait du dossier du jeu (%@)."
          }
        }
      }
    },
    "The download is damaged. Try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement est endommagé. Réessayez."
          }
        }
      }
    },
    "The downloaded zip can't be opened.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le zip téléchargé ne peut pas être ouvert."
          }
        }
      }
    },
    "The file %@ in this package is damaged. Download the package again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier %@ de ce paquet est endommagé. Téléchargez le paquet de nouveau."
          }
        }
      }
    },
    "The files couldn't be put in place. There may not be enough space on the disk.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers n’ont pas pu être mis en place. Le disque manque peut-être d’espace."
          }
        }
      }
    },
    "The game files of this profile are missing. Install the game again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers du jeu de ce profil sont introuvables. Installez le jeu de nouveau."
          }
        }
      }
    },
    "The game is by %@, built on ": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu est de %@, bâti sur "
          }
        }
      }
    },
    "The game is running. Changes apply the next time you play.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu est en cours. Les changements s’appliqueront la prochaine fois que vous jouerez."
          }
        }
      }
    },
    "The game left no log.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu n’a laissé aucun journal."
          }
        }
      }
    },
    "The game left nothing to report.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu n’a rien laissé à signaler."
          }
        }
      }
    },
    "The game stopped unexpectedly": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu s’est arrêté de façon inattendue"
          }
        }
      }
    },
    "The latest release can't be checked: it has no checksum for the Mac build. Try again later.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière version ne peut pas être vérifiée : elle n’a pas de somme de contrôle pour la version Mac. Réessayez plus tard."
          }
        }
      }
    },
    "The latest release has no build for this Mac yet. Try again later.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière version n’a pas encore de version pour ce Mac. Réessayez plus tard."
          }
        }
      }
    },
    "The new language applies after a restart.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nouvelle langue s’applique après un redémarrage."
          }
        }
      }
    },
    "This ROM has been patched. Use an unmodified copy; mods are added in SM Launcher Plus.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette ROM a été modifiée. Utilisez une copie intacte ; les mods s’ajoutent dans SM Launcher Plus."
          }
        }
      }
    },
    "This ROM isn't the supported version. SM Launcher Plus needs Super Metroid (Japan, USA).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette ROM n’est pas la version prise en charge. SM Launcher Plus a besoin de Super Metroid (Japan, USA)."
          }
        }
      }
    },
    "This file is damaged or isn't a mod package.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier est endommagé ou n’est pas un paquet de mod."
          }
        }
      }
    },
    "This file is the wrong size for a SNES ROM.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier n’a pas la bonne taille pour une ROM SNES."
          }
        }
      }
    },
    "This is the ROM of “%@”, not Super Metroid.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est la ROM de « %@ », pas de Super Metroid."
          }
        }
      }
    },
    "This isn't a SNES ROM. Choose a .sfc, .smc or .zip file.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas une ROM SNES. Choisissez un fichier .sfc, .smc ou .zip."
          }
        }
      }
    },
    "This isn't a mod package: it has no manifest.toml at its top level.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas un paquet de mod : il n’a pas de manifest.toml à sa racine."
          }
        }
      }
    },
    "This package has an unsafe file path (%@), so it wasn't installed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce paquet contient un chemin de fichier dangereux (%@). Il n’a donc pas été installé."
          }
        }
      }
    },
    "This package has more than 4096 files, the game's limit.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce paquet contient plus de 4 096 fichiers, la limite du jeu."
          }
        }
      }
    },
    "This package is larger than 256 MB unpacked, the game's limit.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois décompressé, ce paquet dépasse 256 Mo, la limite du jeu."
          }
        }
      }
    },
    "This package is password-protected. The game can't read encrypted packages.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce paquet est protégé par un mot de passe. Le jeu ne peut pas lire les paquets chiffrés."
          }
        }
      }
    },
    "This package uses a compression the game can't read. Its author can zip it again with standard compression.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce paquet utilise une compression que le jeu ne sait pas lire. Son auteur peut le recompresser avec la compression standard."
          }
        }
      }
    },
    "This package's manifest.toml is incomplete or invalid, so the game can't load it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le manifest.toml de ce paquet est incomplet ou invalide. Le jeu ne peut donc pas le charger."
          }
        }
      }
    },
    "This release has no notes.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version n’a pas de notes."
          }
        }
      }
    },
    "This version of the game has no mods.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version du jeu n’a aucun mod."
          }
        }
      }
    },
    "This zip has no .sfc or .smc file in it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce zip ne contient aucun fichier .sfc ou .smc."
          }
        }
      }
    },
    "This zip holds more than one ROM. Choose the Super Metroid one on its own.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce zip contient plus d’une ROM. Choisissez celle de Super Metroid seule."
          }
        }
      }
    },
